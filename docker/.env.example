# Copy this file to docker/.env and fill in real values before running docker-compose.
# docker/.env is gitignored and must never be committed.

# JWT signing key — use a long random string (32+ characters recommended)
JWT_KEY=change-me-use-a-long-random-string-here

# Admin account password — must be set before first run
ADMIN_PASSWORD=change-me-use-a-strong-password
